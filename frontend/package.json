{
  "name": "ticketing-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
